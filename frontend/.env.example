# Dify chatbot URL for the shared agent.
# From the Dify Cloud workspace (udify.app): Agent app -> Publish -> Embed in
# site -> copy the <iframe src> URL. It looks like:
#   https://udify.app/agent/GCccKODnmASobyAm
#
# Leave VITE_DIFY_CHATBOT_URL empty to run the built-in deterministic fallback
# chat (a fully working demo that needs no Dify at all).

# Full iframe src of the Dify chatbot (required for Dify mode)
VITE_DIFY_CHATBOT_URL=https://udify.app/agent/GCccKODnmASobyAm


# Base URL of the deterministic FastAPI service (fallback chat + health)
VITE_API_BASE=http://localhost:8000

# How long to wait for the Dify chatbot to respond before falling back (ms)
VITE_DIFY_TIMEOUT_MS=8000

# Base URL of the local voice (Whisper STT) service for the mic button.
# Same-host default works via the published Docker port or bare-metal uvicorn.
VITE_STT_URL=http://localhost:8100
