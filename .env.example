# Airport Investment Intelligence Agent — environment template.
#
# THE CORE DEMO NEEDS NO SECRETS. Everything below is optional; copy to `.env`
# only for the optional integrations. Never commit real keys.

# --- Data layer (optional) -------------------------------------------------
# 0 = fully offline, reproducible bundled seed (default; no network).
# 1 = attempt authoritative BTS T-100 / OurAirports / FAA downloads on startup
#     (falls back to the seed automatically if downloads fail).
AIRPORT_AGENT_BTS_DOWNLOAD=0

# --- External data-source endpoints (optional) -------------------------------
# Every URL below is read by backend/app/data/endpoints.py and has a safe
# built-in default, so they only need to be set when pointing at a mirror
# or an updated upstream endpoint. Changing them never changes the analytics
# schema — they only control WHERE authoritative files are fetched from when
# AIRPORT_AGENT_BTS_DOWNLOAD=1 (with the default 0 no network is touched).
BTS_BASE_URL=https://www.transtats.bts.gov/DownLoad_Table.asp
BTS_T100_QUERY=?Table_ID=311&Year={year}&AllVars=1&Zype=csv
FAA_ENPLANEMENTS_URL=https://www.faa.gov/airports/planning_capacity/passenger_allcargo_stats/passenger/media/cy23-all-enplanements.xlsx
OURAIRPORTS_URL=https://davidmegginson.github.io/ourairports-data/airports.csv

# --- React client (optional) — already wired in docker-compose ----------
# The variables below are passed through by docker-compose.yml; only set them
# here when you want to override the in-file defaults.
# Dify chatbot page URL for the iframe mode. docker-compose.yml already
# defaults to the shared Dify Cloud chatbot, so no change is needed for the
# demo. If unset or unreachable, the frontend automatically falls back to
# the built-in deterministic chat (POST /api/chat). Voice works only if the
# Dify workspace has STT enabled.
VITE_DIFY_CHATBOT_URL=
# Backend the fallback chat / analytics calls hit (dev proxy default below).
VITE_API_BASE=http://localhost:8000

# --- Local voice / STT service (starts with the Docker stack by default) ---
# faster-whisper model: tiny | base | small | medium | large-v3
STT_MODEL_SIZE=base
# cpu | cuda (GPU optional; CPU with 4GB+ free RAM is sufficient for tiny/base)
STT_DEVICE=cpu

# --- Dify (primary chat orchestrator) ---------------------------------------
# The chat runs on the hosted Dify Cloud workspace; LLM provider keys are
# configured inside Dify's own workspace UI, never in this repo.
# See dify/README.md.
